                         prompt_completion_ids,
@@ -1675,6 +1681,14 @@
             kl_loss = alpha * kl_teacher + (1 - alpha) * kl_student
         per_token_loss = kl_loss.sum(-1)
 
+        # Add the beta KL anchor to the objective. In the upstream vendored code
+        # per_token_kl was computed only for logging (kl_to_base_model) and NEVER added
+        # to the loss, so beta>0 was a no-op on training. Here it actually regularizes the
+        # student toward the reference (the frozen base when anchor_to_base is set),
+        # testing whether the anchor stabilizes the EMA teacher over the long horizon.
+        if self.beta != 0.0:
+            per_token_loss = per_token_loss + self.beta * per_token_kl
+
