+            # Compute the per-token log probabilities for the reference model.
+            # anchor_to_base (set externally): force the beta anchor to use the FROZEN
+            # BASE (student with adapter disabled), NOT self.ref_model. This matters when
+            # the EMA teacher is on (sync_ref_model=True): there self.ref_model IS the
+            # moving-average teacher, which collapses along with the student, so anchoring
+            # to it has ~zero corrective pressure. Forcing disable_adapter() gives the true
+            # base, so KL(student||base) actually regularizes. Default False = upstream.
             if self.beta != 0.0:
-                if self.ref_model is not None:
+                if self.ref_model is not None and not getattr(self, "anchor_to_base", False):
                     ref_per_token_logps, _, _ = self._get_per_token_logps_and_entropies(
